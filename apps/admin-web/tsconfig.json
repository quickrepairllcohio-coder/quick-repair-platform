{
    "compilerOptions":  {
                            "strict":  true,
                            "jsx":  "preserve",
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "noEmit":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "target":  "es2022",
                            "skipLibCheck":  true
                        },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts"
                ]
}
